{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/generate-overview-hero-data.mjs && node scripts/validate-overview-v10.mjs && vinext dev",
    "test:fixtures": "node --experimental-strip-types scripts/validate-sample-data.mjs",
    "test:contracts": "node scripts/validate-system-contracts.mjs",
    "test:overview": "node scripts/generate-overview-hero-data.mjs && node scripts/validate-overview-v10.mjs",
    "test:system": "npm run test:fixtures && npm run test:contracts && npm run test:overview",
    "build": "npm run test:system && vinext build && node scripts/patch-wrangler-media.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "package:cloudflare-final": "node scripts/package-cloudflare-final.mjs",
    "setup:local-test": "CI=1 wrangler d1 migrations apply site-creator-d1 --local --config wrangler.local.jsonc",
    "test:local": "npm run setup:local-test && npm run test:overview && vinext dev --open",
    "package:local-test": "node scripts/package-local-test.mjs",
    "package:one-click-local": "node scripts/package-one-click-local.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "wrangler": "^4.120.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  }
}
